# =============================================================================
# AIDD-Ops — Cal.com (.env.example)
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env com valores reais.
# =============================================================================

# Conexão com PostgreSQL centralizado (banco calcom_db)
# O init-multiple-databases.sh do bloco postgres cria este banco automaticamente
POSTGRES_HOST=postgres
CALCOM_DB_NAME=calcom_db
CALCOM_DB_USER=calcom_user
CALCOM_DB_PASSWORD=

# Chaves de segurança (obrigatório — gere com: openssl rand -hex 32 cada uma)
CALCOM_NEXTAUTH_SECRET=
CALCOM_ENCRYPTION_KEY=

# Host público de roteamento via Traefik (NIH #16):
# Sem porta de host publicada — o acesso é exclusivo pelo reverse proxy.
# Aponte o DNS/`/etc/hosts` para o IP do host onde o Traefik roda.
CALCOM_HOST=cal.localhost

# Licença Cal.com (opcional — funcionalidades premium)
CALCOM_LICENSE_KEY=

# Limites de memória
CALCOM_MAX_RAM=1g
CALCOM_REDIS_MAX_RAM=128m