# =============================================================================
# AIDD-Ops — Authentik SSO com PostgreSQL Próprio (.env.example)
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env com valores reais.
# =============================================================================

# Credenciais do banco PostgreSQL do Authentik (obrigatório — sem valor default seguro)
# NOTA: Authentik usa banco PRÓPRIO, não compartilha com o PostgreSQL centralizado
AUTHENTIK_DB_NAME=authentik
AUTHENTIK_DB_USER=authentik
AUTHENTIK_DB_PASSWORD=

# Chave secreta do Authentik (obrigatório — gere com: openssl rand -hex 32)
AUTHENTIK_SECRET_KEY=

# Portas expostas no host
AUTHENTIK_HTTP_PORT=9000
AUTHENTIK_HTTPS_PORT=9443

# Limites de memória
AUTHENTIK_DB_MAX_RAM=512m
AUTHENTIK_SERVER_MAX_RAM=512m
AUTHENTIK_WORKER_MAX_RAM=256m
