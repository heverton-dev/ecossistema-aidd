# =============================================================================
# AIDD-Ops — PostgreSQL Centralizado (.env.example)
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env com valores reais.
# =============================================================================

# Credenciais do admin do PostgreSQL (obrigatório — sem valor default seguro)
POSTGRES_ADMIN_USER=postgres_admin
POSTGRES_ADMIN_PASSWORD=

# Lista de bancos lógicos a criar na inicialização (separados por vírgula)
# Cada banco terá um usuário dedicado <nome_banco>_user criado automaticamente
POSTGRES_MULTIPLE_DATABASES=authentik_db,twenty_db,chatwoot_db,calcom_db

# Senhas dos bancos individuais (opcional — se vazio, usa POSTGRES_ADMIN_PASSWORD)
# O init-multiple-databases.sh tenta ler POSTGRES_PASSWORD_<nome_banco>
# Exemplo: POSTGRES_PASSWORD_twenty_db=senha_forte_aqui
# POSTGRES_PASSWORD_authentik_db=
# POSTGRES_PASSWORD_twenty_db=
# POSTGRES_PASSWORD_chatwoot_db=
# POSTGRES_PASSWORD_calcom_db=

# Porta exposta no host (apenas para debug — em produção, use rede interna)
POSTGRES_PORT=5432

# Limite de memória do container
POSTGRES_MAX_RAM=1g
