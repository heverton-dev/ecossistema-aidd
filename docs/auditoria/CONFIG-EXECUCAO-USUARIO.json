{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descricao": "Configuração de Execução do Usuário - Claude com -p explícito",
  "versao": "2.0.0",
  "pipeline_auditoria_4f": {
    "inspetor": { "harness": "claude", "model": "haiku", "comando_terminal": "claude --dangerously-skip-permissions --chrome --model haiku" },
    "arquiteto": {"harness": "agy", "model": "gemini-3.8-flash-low", "comando_terminal": "agy --model gemini-3.8-flash-low  --dangerously-skip-permissions"},
    "construtor": {"harness": "mimo", "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash", "comando_terminal": "mimo -m xiaomi-token-plan-sgp/mimo-v2.6-flash --pure"},
    "retorno": {"harness": "opencode", "model": "opencode/big-pickle", "comando_terminal": "opencode --pure --auto --agent -m opencode/big-pickle"}
  },
  "pipeline_evolucao_rotativo": [
    {"harness": "claude", "model": "haiku", "comando_terminal": "claude --dangerously-skip-permissions --chrome --model haiku"},
    {"harness": "agy", "model": "gemini-3.8-flash-low", "comando_terminal": "agy --model gemini-3.8-flash-low  --dangerously-skip-permissions"},
    {"harness": "mimo", "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash", "comando_terminal": "mimo -m xiaomi-token-plan-sgp/mimo-v2.6-flash --pure"},
    {"harness": "opencode", "model": "opencode/big-pickle", "comando_terminal": "opencode --pure --auto --agent -m opencode/big-pickle"}
  ]
}
