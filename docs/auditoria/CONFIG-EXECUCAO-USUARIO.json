{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "descricao": "Configuração de Execução do Usuário: Fases Fixas de Auditoria e Revezamento Cíclico de Evolução",
  "versao": "2.0.0",
  "pipeline_auditoria_4f": {
    "inspetor": {
      "harness": "mimo",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "comando_terminal": "mimo --pure -m xiaomi-token-plan-sgp/mimo-v2.6-flash"
    },
    "arquiteto": {
      "harness": "opencode",
      "model": "opencode/big-pickle",
      "comando_terminal": "opencode --pure --auto --agent -m opencode/big-pickle"
    },
    "construtor": {
      "harness": "agy",
      "model": "gemini-3.8-flash-high",
      "comando_terminal": "agy --model gemini-3.8-flash-high --dangerously-skip-permissions"
    },
    "retorno": {
      "harness": "claude",
      "model": "opus",
      "comando_terminal": "claude --dangerously-skip-permissions --chrome --model opus"
    }
  },
  "pipeline_evolucao_rotativo": [
    {
      "harness": "agy",
      "model": "gemini-3.8-flash-high",
      "comando_terminal": "agy --model gemini-3.8-flash-high --dangerously-skip-permissions"
    },
    {
      "harness": "claude",
      "model": "opus",
      "comando_terminal": "claude --dangerously-skip-permissions --chrome --model opus"
    },
    {
      "harness": "opencode",
      "model": "opencode/big-pickle",
      "comando_terminal": "opencode --pure --auto --agent -m opencode/big-pickle"
    },
    {
      "harness": "mimo",
      "model": "xiaomi-token-plan-sgp/mimo-v2.6-flash",
      "comando_terminal": "mimo --pure -m xiaomi-token-plan-sgp/mimo-v2.6-flash"
    }
  ]
}
