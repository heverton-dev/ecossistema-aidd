      "agent_flag": "--agent",
      "agent": "",
      "extra_flags": [
        "--pure"
      ],
      "startup_wait_seconds": 10,
      "usage_note": "Alias explícito roteado pelo 9Router (wrapper opencode-9router)."
    },
    "mimo": {
      "binary": "mimo-9router",
      "auto_approve_flag": null,
      "prompt_mode": "flag_value",
      "prompt_flag": "--prompt",
      "model_flag": "-m",
      "default_model": "aidd9r/code-fast",
      "extra_flags": [
        "--pure"
      ],
      "startup_wait_seconds": 10,
      "usage_note": "Roteado pelo 9Router (wrapper mimo-9router) com provedor aidd9r e combo code-fast."
    },
    "mimo-9router": {
      "binary": "mimo-9router",
      "auto_approve_flag": null,
      "prompt_mode": "flag_value",
      "prompt_flag": "--prompt",
      "model_flag": "-m",
      "default_model": "aidd9r/code-fast",
      "extra_flags": [
        "--pure"
      ],
      "startup_wait_seconds": 10,
      "usage_note": "Alias explícito roteado pelo 9Router (wrapper mimo-9router)."
    },
    "omp": {
      "binary": "omp-9router",
      "auto_approve_flag": null,
      "prompt_mode": "positional",
      "prompt_flag": null,
      "model_flag": "--model",
      "default_model": "aidd9r/code-fast",
      "extra_flags": [],
      "startup_wait_seconds": 10,
      "usage_note": "Roteado pelo 9Router (wrapper omp-9router) usando provedor aidd9r configurado no models.yml."
