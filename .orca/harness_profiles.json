{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "_comment": "Perfis de harness para orquestração em worktrees nativas e ORCA ADE roteados via 9Router.",
  "profiles": {
    "claude": {
      "binary": "claude-9router",
      "auto_approve_flag": "--dangerously-skip-permissions",
      "prompt_mode": "positional",
      "prompt_flag": null,
      "model_flag": "--model",
      "default_model": "sonnet",
      "extra_flags": [
        "--chrome"
      ],
      "startup_wait_seconds": 10,
      "usage_note": "Roteado pelo 9Router (wrapper claude-9router). Modelos: opus -> code-pro, sonnet -> code-fast, haiku -> code-free."
    },
    "claude-9router": {
      "binary": "claude-9router",
      "auto_approve_flag": "--dangerously-skip-permissions",
      "prompt_mode": "positional",
      "prompt_flag": null,
      "model_flag": "--model",
      "default_model": "sonnet",
      "extra_flags": [
        "--chrome"
      ],
      "startup_wait_seconds": 10,
      "usage_note": "Alias explícito roteado pelo 9Router (wrapper claude-9router)."
    },
    "opencode": {
      "binary": "opencode-9router",
      "auto_approve_flag": "--auto",
      "prompt_mode": "flag_value",
      "prompt_flag": "--prompt",
      "model_flag": "-m",
      "default_model": "aidd9r/code-fast",
      "agent_flag": "--agent",
      "agent": "",
      "extra_flags": [
        "--pure"
      ],
      "startup_wait_seconds": 10,
      "usage_note": "Roteado pelo 9Router (wrapper opencode-9router) com provedor aidd9r e combo code-fast."
    },
    "opencode-9router": {
      "binary": "opencode-9router",
      "auto_approve_flag": "--auto",
