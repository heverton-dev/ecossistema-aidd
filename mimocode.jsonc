{
  "$schema": "https://mimo.xiaomi.com/mimocode/config.json",
  "command": {
    "freedom": {
      "description": "Dispara o Fluxo 03 (Low-Code / Apps Unificadas) da Tríade Canônica",
      "template": "Execute imediatamente o Fluxo 03 (aidd-freedom) da Tríade Canônica para o export: $ARGUMENTS. Use a skill aidd-freedom ou comando CLI: python ecossistema.py freedom $ARGUMENTS"
    },
    "pure": {
      "description": "Dispara o Fluxo 01 (Do Zero Puro) da Tríade Canônica",
      "template": "Execute imediatamente o Fluxo 01 (aidd-pure) da Tríade Canônica para o projeto: $ARGUMENTS. Use a skill aidd-pure ou comando CLI: python ecossistema.py pure $ARGUMENTS"
    },
    "open": {
      "description": "Dispara o Fluxo 02 (Motores Open-Source) da Tríade Canônica",
      "template": "Execute imediatamente o Fluxo 02 (aidd-open) da Tríade Canônica para o projeto: $ARGUMENTS. Use a skill aidd-open ou comando CLI: python ecossistema.py open $ARGUMENTS"
    },
    "bridge": {
      "description": "Executa operacoes atomicas da ferramenta aidd-bridge (scan, convert-db, merge, pack)",
      "template": "Execute a operacao atomica da ferramenta aidd-bridge: $ARGUMENTS. Use a skill aidd-bridge-runner ou CLI: python ecossistema.py bridge $ARGUMENTS"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    },
    "context7": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@upstash/context7-mcp"
      ],
      "enabled": true
    },
    "github": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "enabled": true,
      "environment": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      }
    },
    "cloudflare": {
      "type": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "cloudflare-docs": {
      "type": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "enabled": true
    },
    "code-review-graph": {
      "type": "local",
      "command": [
        "code-review-graph",
        "serve"
      ],
      "enabled": true,
      "cwd": "C:\\Users\\trcnologia\\Desktop\\ecossistema-aidd"
    }
  }
}
