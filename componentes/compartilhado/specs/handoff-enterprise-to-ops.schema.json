{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffEnterpriseToOpsSchema",
  "description": "Contrato formal de transferência do projeto blindado pelo aidd-enterprise para o aidd-ops (C5) para empacotamento, Docker e deploy VPS.",
  "type": "object",
  "required": [
    "versao_schema",
    "diretorio_projeto",
    "registry",
    "selo_sha256",
    "drift",
    "perfil_app"
  ],
  "properties": {
    "versao_schema": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "diretorio_projeto": {
      "type": "string",
      "minLength": 2
    },
    "registry": {
      "type": "object",
      "required": ["caminho", "sha256"],
      "properties": {
        "caminho": { "type": "string" },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "description": "Caminho relativo do COMPONENT-REGISTRY.json e seu respectivo hash SHA-256."
    },
    "selo_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Hash SHA-256 do conjunto de componentes blindados."
    },
    "drift": {
      "type": "object",
      "required": ["verificado", "exit_code"],
      "properties": {
        "verificado": { "type": "boolean", "enum": [true] },
        "exit_code": { "type": "integer", "enum": [0] }
      },
      "description": "Resultado da execução real do verificador de drift (exit code 0)."
    },
    "perfil_app": {
      "type": "object",
      "required": ["tipo_runtime", "portas_expostas", "banco"],
      "properties": {
        "tipo_runtime": {
          "type": "string",
          "enum": ["monolito_modular_docker", "compose_multi_service"]
        },
        "portas_expostas": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer" }
        },
        "banco": { "type": "string" },
        "servicos_adicionais": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "description": "Perfil operacional do aplicativo derivado dinamicamente da planta."
    }
  }
}
