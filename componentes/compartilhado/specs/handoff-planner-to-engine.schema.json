{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffPlannerToEngineSchema",
  "description": "Contrato formal e determinístico de transferência de artefatos do aidd-planner para qualquer Engine de Construção (generator, factory ou bridge).",
  "type": "object",
  "required": [
    "versao_schema",
    "fluxo_alvo",
    "metadados_projeto",
    "quarteto_sine_qua_non",
    "arquitetura_alvo",
    "modulos_funcionais"
  ],
  "properties": {
    "versao_schema": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "fluxo_alvo": {
      "type": "integer",
      "enum": [1, 2, 3],
      "description": "1 = Do Zero Puro (generator), 2 = Open Source (factory), 3 = Low-Code Bridge (bridge)"
    },
    "metadados_projeto": {
      "type": "object",
      "required": ["nome", "slug", "dominio", "descricao"],
      "properties": {
        "nome": { "type": "string", "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "dominio": { "type": "string", "minLength": 2 },
        "descricao": { "type": "string", "minLength": 10 }
      }
    },
    "quarteto_sine_qua_non": {
      "type": "object",
      "required": ["swagger", "webhooks", "mcp", "documentacao"],
      "properties": {
        "swagger": { "type": "boolean", "enum": [true] },
        "webhooks": { "type": "boolean", "enum": [true] },
        "mcp": { "type": "boolean", "enum": [true] },
        "documentacao": { "type": "boolean", "enum": [true] }
      }
    },
    "arquitetura_alvo": {
      "type": "object",
      "required": ["padrao_frontend", "padrao_backend", "persistencia"],
      "properties": {
        "padrao_frontend": {
          "type": "string",
          "enum": ["nextjs_typescript_tailwind"]
        },
        "padrao_backend": {
          "type": "string",
          "enum": ["fastapi_modular_vsa"]
        },
        "persistencia": {
          "type": "string",
          "enum": ["sqlite_wal", "postgresql"]
        }
      }
    },
    "modulos_funcionais": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["nome", "slug", "entidades", "regras_negocio"],
        "properties": {
          "nome": { "type": "string" },
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "entidades": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["nome", "campos"],
              "properties": {
                "nome": { "type": "string" },
                "campos": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["nome", "tipo", "obrigatorio"],
                    "properties": {
                      "nome": { "type": "string" },
                      "tipo": { "type": "string", "enum": ["string", "integer", "boolean", "datetime", "float", "json"] },
                      "obrigatorio": { "type": "boolean" }
                    }
                  }
                }
              }
            }
          },
          "regras_negocio": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "descricao", "criterio_aceitacao"],
              "properties": {
                "id": { "type": "string" },
                "descricao": { "type": "string" },
                "criterio_aceitacao": { "type": "string" }
              }
            }
          }
        }
      }
    }
  }
}
