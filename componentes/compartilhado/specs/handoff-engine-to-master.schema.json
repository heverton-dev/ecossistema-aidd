{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffEngineToMasterSchema",
  "description": "Contrato formal e determinístico de transferência dos módulos e regras gerados pela Engine para a harmonização Monolito Modular VSA no aidd-master (C3).",
  "type": "object",
  "required": [
    "versao_schema",
    "origem_engine",
    "projeto_slug",
    "slices_geradas",
    "artefatos_frontend",
    "testes_executados",
    "arquivos_fora_da_zona"
  ],
  "properties": {
    "versao_schema": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "origem_engine": {
      "type": "string",
      "enum": ["aidd-pure", "aidd-open", "aidd-freedom"]
    },
    "projeto_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "slices_geradas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slice_nome", "caminho_src", "sha256_arvore", "endpoints", "tabelas_sql"],
        "properties": {
          "slice_nome": { "type": "string" },
          "caminho_src": {
            "type": "string",
            "pattern": "^src/modules/[^/]+",
            "description": "Caminho da fatia, obrigatoriamente sob src/modules/<dominio>/."
          },
          "sha256_arvore": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hash SHA-256 do conteúdo da árvore de diretórios da fatia gerada."
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rota", "metodo", "funcao"],
              "properties": {
                "rota": { "type": "string" },
                "metodo": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
                "funcao": { "type": "string" }
              }
            }
          },
          "tabelas_sql": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "artefatos_frontend": {
      "type": "object",
      "required": ["tecnologia", "paginas_geradas", "origem_design"],
      "properties": {
        "tecnologia": { "type": "string", "enum": ["nextjs_app_router", "tanstack_router"] },
        "paginas_geradas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "origem_design": {
          "type": "string",
          "enum": ["tailwind_standard", "lovable_preserved", "custom_tdd"]
        }
      }
    },
    "testes_executados": {
      "type": "object",
      "required": ["total", "passaram", "falharam", "zero_stubs", "relatorio_pytest"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passaram": { "type": "integer", "minimum": 1 },
        "falharam": { "type": "integer", "maximum": 0 },
        "zero_stubs": { "type": "boolean", "enum": [true] },
        "relatorio_pytest": {
          "type": "object",
          "required": ["caminho", "exit_code"],
          "properties": {
            "caminho": { "type": "string" },
            "exit_code": { "type": "integer", "enum": [0] }
          },
          "description": "Evidência real de execução de testes vinda de relatório do pytest."
        }
      }
    },
    "arquivos_fora_da_zona": {
      "type": "array",
      "maxItems": 0,
      "description": "Lista de arquivos criados fora da zona permitida pelo mapa de donos; deve ser estritamente vazia."
    }
  }
}
