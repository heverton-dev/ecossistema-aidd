{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HandoffEngineToMasterSchema",
  "description": "Contrato formal e determinístico de transferência dos módulos e regras gerados pela Engine para a harmonização Monolito Modular VSA no aidd-master.",
  "type": "object",
  "required": [
    "versao_schema",
    "origem_engine",
    "projeto_slug",
    "slices_geradas",
    "artefatos_frontend",
    "testes_executados"
  ],
  "properties": {
    "versao_schema": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "origem_engine": {
      "type": "string",
      "enum": ["aidd-generator", "aidd-factory", "aidd-bridge"]
    },
    "projeto_slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "slices_geradas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["slice_nome", "caminho_src", "endpoints", "tabelas_sql"],
        "properties": {
          "slice_nome": { "type": "string" },
          "caminho_src": { "type": "string" },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rota", "metodo", "funcao"],
              "properties": {
                "rota": { "type": "string" },
                "metodo": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
                "funcao": { "type": "string" }
              }
            }
          },
          "tabelas_sql": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "artefatos_frontend": {
      "type": "object",
      "required": ["tecnologia", "paginas_geradas", "origem_design"],
      "properties": {
        "tecnologia": { "type": "string", "enum": ["nextjs_app_router"] },
        "paginas_geradas": {
          "type": "array",
          "items": { "type": "string" }
        },
        "origem_design": {
          "type": "string",
          "enum": ["tailwind_standard", "lovable_preserved", "custom_tdd"]
        }
      }
    },
    "testes_executados": {
      "type": "object",
      "required": ["total", "passaram", "falharam", "zero_stubs"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "passaram": { "type": "integer", "minimum": 1 },
        "falharam": { "type": "integer", "maximum": 0 },
        "zero_stubs": { "type": "boolean", "enum": [true] }
      }
    }
  }
}
