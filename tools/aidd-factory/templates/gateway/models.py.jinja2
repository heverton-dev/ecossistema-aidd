    """Proxy request para {{ servico.nome }}."""
    path: str = Field(..., description="Caminho a ser proxyado")
    method: str = Field("GET", description="HTTP method")
    body: Optional[dict] = Field(None, description="Corpo da requisicao")


class {{ servico.nome_camel }}ProxyResponse(BaseModel):
    """Response do proxy {{ servico.nome }}."""
