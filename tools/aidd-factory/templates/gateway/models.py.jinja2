from pydantic import BaseModel, Field
from typing import Optional, List
from datetime import datetime


class HealthResponse(BaseModel):
    status: str = Field(..., description="Status do servico: ok, degraded, down")


class GatewayHealthResponse(BaseModel):
    status: str = Field(..., description="Status geral: healthy, degraded")
    services: dict = Field(..., description="Status por servico")

