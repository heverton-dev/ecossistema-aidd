# Modo Headless (fallback) do aidd-generator: copie para .env e preencha com
# chaves reais. NUNCA commite o .env (ja esta no .gitignore). Este arquivo e
# carregado automaticamente por scripts/phases/utils_delegacao.py, independente
# da pasta onde a pipeline for executada.

# --- Provedor ativo ---
LLM_MODEL=groq/llama-3.3-70b-versatile
GROQ_API_KEY=

# --- Alternativas (troque LLM_MODEL para usar) ---
NVIDIA_NIM_API_KEY=
# LLM_MODEL=nvidia_nim/meta/llama-3.3-70b-instruct

OPENROUTER_API_KEY=
# LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free

TOGETHERAI_API_KEY=
# LLM_MODEL=together_ai/meta-llama/Llama-3.3-70B-Instruct-Turbo

# --- Endpoints custom (openai-compatible): confirme modelo/base antes de usar ---
# OPENAI_API_KEY=
# OPENAI_API_BASE=
# LLM_MODEL=openai/<modelo>

# Timeout por chamada LLM headless (segundos) -- evita travar indefinidamente
LLM_TIMEOUT_SEGUNDOS=120
