# =============================================================================
# AIDD-Ops — Twenty CRM (.env.example)
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env com valores reais.
# =============================================================================

# Conexão com PostgreSQL centralizado (banco twenty_db)
# O init-multiple-databases.sh do bloco postgres cria este banco automaticamente
POSTGRES_HOST=postgres
TWENTY_DB_NAME=twenty_db
TWENTY_DB_USER=twenty_user
TWENTY_DB_PASSWORD=

# URLs do servidor e frontend
TWENTY_SERVER_URL=http://localhost:3000
TWENTY_FRONT_URL=http://localhost:3001

# Tokens de segurança (obrigatório — gere com: openssl rand -hex 32 cada um)
TWENTY_ACCESS_TOKEN_SECRET=
TWENTY_LOGIN_TOKEN_SECRET=
TWENTY_REFRESH_TOKEN_SECRET=
TWENTY_FILE_TOKEN_SECRET=

# Portas expostas no host
TWENTY_SERVER_PORT=3000
TWENTY_FRONT_PORT=3001

# Limites de memória
TWENTY_SERVER_MAX_RAM=1g
TWENTY_FRONT_MAX_RAM=256m
TWENTY_REDIS_MAX_RAM=128m
