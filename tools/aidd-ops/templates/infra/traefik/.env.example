# =============================================================================
# AIDD-Ops — Traefik com TLS Let's Encrypt (.env.example)
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env com valores reais.
# =============================================================================

# E-mail para registro no Let's Encrypt (obrigatório — sem valor default seguro)
ACME_EMAIL=

# Token da API DNS para challenge TLS (Cloudflare, etc.)
# Deixe vazio se não usar DNS challenge
CF_DNS_API_TOKEN=

# Portas expostas no host
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# Host do dashboard Traefik (acesso interno apenas)
TRAEFIK_DASHBOARD_HOST=traefik.localhost

# Nível de log: DEBUG, INFO, WARN, ERROR
TRAEFIK_LOG_LEVEL=INFO

# Limite de memória do container
TRAEFIK_MAX_RAM=256m
