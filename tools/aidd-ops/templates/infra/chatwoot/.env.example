# =============================================================================
# AIDD-Ops — Chatwoot (.env.example)
# =============================================================================
# Copie este arquivo para .env e preencha os valores.
# NUNCA versione o .env com valores reais.
# =============================================================================

# Conexão com PostgreSQL centralizado (banco chatwoot_db)
# O init-multiple-databases.sh do bloco postgres cria este banco automaticamente
POSTGRES_HOST=postgres
CHATWOOT_DB_NAME=chatwoot_db
CHATWOOT_DB_USER=chatwoot_user
CHATWOOT_DB_PASSWORD=

# Chave secreta do Rails (obrigatório — gere com: rake secret)
CHATWOOT_SECRET_KEY_BASE=

# URL do frontend
CHATWOOT_FRONTEND_URL=http://localhost:3000

# Porta exposta no host
CHATWOOT_RAILS_PORT=3000

# Limites de memória
CHATWOOT_RAILS_MAX_RAM=1g
CHATWOOT_SIDEKIQ_MAX_RAM=512m
CHATWOOT_REDIS_MAX_RAM=128m
