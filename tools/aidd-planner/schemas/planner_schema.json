{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDD-Planner Canonical Schema",
  "description": "Schema canônico e polimórfico de planejamento para a Tríade Canônica do ecossistema AIDD (Fluxos 1, 2 e 3).",
  "type": "object",
  "required": [
    "meta",
    "ddd_bounded_contexts",
    "bdd_cenarios",
    "quarteto_sine_qua_non",
    "infraestrutura_alvo",
    "payload_especifico_fluxo"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["projeto_nome", "slug", "versao", "descricao", "dominio", "fluxo_alvo"],
      "properties": {
        "projeto_nome": { "type": "string", "minLength": 2 },
        "slug": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "versao": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "descricao": { "type": "string", "minLength": 10 },
        "dominio": { "type": "string", "minLength": 2 },
        "fluxo_alvo": {
          "type": "string",
          "enum": ["fluxo_01_generator", "fluxo_02_factory", "fluxo_03_bridge"]
        }
      }
    },
    "ddd_bounded_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["modulo", "descricao", "entidades"],
        "properties": {
          "modulo": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "descricao": { "type": "string", "minLength": 5 },
          "entidades": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["nome", "atributos", "regras_invariantes"],
              "properties": {
                "nome": { "type": "string", "minLength": 2 },
                "atributos": { "type": "object", "minProperties": 1 },
                "regras_invariantes": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 5 }
                }
              }
            }
          }
        }
      }
    },
    "bdd_cenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "modulo", "titulo", "dado", "quando", "entao"],
        "properties": {
          "id": { "type": "string", "pattern": "^(SCN|BDD)-[0-9]{3,}$" },
          "modulo": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "titulo": { "type": "string", "minLength": 5 },
          "dado": { "type": "string", "minLength": 5 },
          "quando": { "type": "string", "minLength": 5 },
          "entao": { "type": "string", "minLength": 5 }
        }
      }
    },
    "quarteto_sine_qua_non": {
      "type": "object",
      "required": ["swagger", "webhooks", "mcp", "docs"],
      "properties": {
        "swagger": {
          "type": "object",
          "required": ["ativo", "prefixo"],
          "properties": {
            "ativo": { "type": "boolean", "const": true },
            "prefixo": { "type": "string", "default": "/swagger" }
          }
        },
        "webhooks": {
          "type": "object",
          "required": ["ativo", "eventos_suportados"],
          "properties": {
            "ativo": { "type": "boolean", "const": true },
            "eventos_suportados": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 2 }
            }
          }
        },
        "mcp": {
          "type": "object",
          "required": ["ativo", "ferramentas_expostas"],
          "properties": {
            "ativo": { "type": "boolean", "const": true },
            "ferramentas_expostas": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 2 }
            }
          }
        },
        "docs": {
          "type": "object",
          "required": ["ativo", "guia_usuario"],
          "properties": {
            "ativo": { "type": "boolean", "const": true },
            "guia_usuario": { "type": "boolean", "const": true }
          }
        }
      }
    },
    "infraestrutura_alvo": {
      "type": "object",
      "required": ["banco_dados", "porta_api", "ambiente"],
      "properties": {
        "banco_dados": { "type": "string", "enum": ["postgresql", "sqlite"] },
        "porta_api": { "type": "integer", "minimum": 1024, "maximum": 65535 },
        "ambiente": { "type": "string", "minLength": 3 }
      }
    },
    "payload_especifico_fluxo": {
      "type": "object",
      "description": "Payload de especialização estrita conforme meta.fluxo_alvo"
    }
  }
}
