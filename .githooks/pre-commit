#!/bin/sh
# Quality gates (framework pre-commit) + auto-syncs do repositorio.
#
# Migrado em NIH #4 (Fase 2-Gates3): o runner proprio dos quality gates
# ('python ecossistema.py audit') foi substituido pelo framework pre-commit.
# Este hook e o unico ponto de entrada do git; ele:
#   1. Roda os quality gates (gates/G_*.py) definidos em
#      .pre-commit-config.yaml como hooks locais hermeticos
#      (repo: local, language: system).
#   2. Depois dos gates passarem, continua os auto-syncs que sempre viveram
#      aqui: components sync, planos index, telemetria e code-review-graph.
#
# Instalado via: git config core.hooksPath .githooks
# (feito automaticamente por 'python ecossistema.py dependencia bootstrap',
#  ou manualmente com o comando acima).

set -e

# Sem isto, qualquer gate que imprima acentuacao (a maioria, sao todos em
# PT-BR) sai com mojibake no console padrao do Windows (codepage cp1252) --
# mesma causa raiz do crash de U+2713 corrigido em ecossistema.py::run_command,
# aqui so afeta legibilidade (nao derruba o hook), mas atrapalha exatamente
# o "descritivo e facil de identificar" que os logs precisam ser.
export PYTHONIOENCODING=utf-8

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# --- 0. Quality gates via pre-commit (NIH #4) ---
# Roda SO SE o framework estiver instalado; senao, avisa e segue (bootstrap
# agnostico — nunca trava commit numa maquina ainda sem pre-commit). O
# equivalente manual continua em 'python ecossistema.py audit'.
if python -m pre_commit --version >/dev/null 2>&1; then
  echo "[pre-commit] Rodando quality gates (framework pre-commit)..."
  # --verbose: sem isso, o pre-commit ESCONDE a saida de cada hook ate ele
  # terminar (so mostra na tela se falhar) -- gates lentos (ex: G_TESTES_REAIS,
  # ~5min rodando pytest de 7 ferramentas) pareciam travados/mudos por
  # minutos, mesmo ja imprimindo progresso em tempo real internamente.
  # --color always: as duas flags juntas sao o que faz o "Passed"/"Failed"
  # de cada gate aparecer colorido E ao vivo, em vez de um bloco de texto
  # sem cor só no final.
  if ! python -m pre_commit run --color always --verbose; then
    echo "[pre-commit] ERRO: quality gates reprovaram. Corrija antes do commit."
    echo "[pre-commit]       Diagnostico: rode 'python ecossistema.py audit' ou os hooks individualmente."
    echo "[pre-commit]       Arquivos modificados no working tree agora (pode revelar efeito colateral de um hook):"
    git status --short | sed 's/^/[pre-commit]         /'
    exit 1
  fi
else
  echo "[pre-commit] AVISO: pre-commit nao instalado — pulando quality gates. Instale com: pip install pre-commit"
fi

STAGED="$(git diff --cached --name-only)"

# --- 1. Auto-espelha componentes/ para todos os harnesses ---
# Roda 'components sync --tipo todos' e reinclui no MESMO commit qualquer
# cópia que o sync tenha criado/atualizado, sem tocar em nenhum outro
# arquivo que já estivesse modificado por outro motivo.
if echo "$STAGED" | grep -q '^componentes/'; then
  echo "[pre-commit] Mudanca em componentes/ detectada - rodando 'components sync --tipo todos'..."

  if ! python ecossistema.py components sync --tipo todos; then
    echo "[pre-commit] ERRO: components sync falhou. Commit abortado - corrija e tente de novo."
    exit 1
  fi

  # Re-adiciona so as pastas-espelho conhecidas (nomes fixos de harness),
  # nunca um diretorio arbitrario que ja estivesse sujo por outro motivo.
  MIRROR_DIRS=".claude .agents .agent .opencode .mimocode .cursor .gemini .github .skills skills"

  for dir in $MIRROR_DIRS; do
    [ -d "$dir" ] && git add -- "$dir" 2>/dev/null
  done

  for tool_dir in tools/*/; do
    for dir in $MIRROR_DIRS; do
      alvo="${tool_dir}${dir}"
      [ -d "$alvo" ] && git add -- "$alvo" 2>/dev/null
    done
  done

  echo "[pre-commit] Copias espelhadas incluidas no commit."
fi

# --- 2. Mantem docs/planos/ (feitos/fazendo/a-fazer + INDEX.md) sincronizado ---
# Roda o atualizador deterministico, que recalcula o status real de cada
# iniciativa, MOVE fisicamente a pasta/arquivo para feitos/fazendo/a-fazer
# se o status mudou, e reescreve INDEX.md. Qualquer movimentacao ou
# reescrita e reincluida no MESMO commit, para nunca ficar desatualizado.
if echo "$STAGED" | grep -q '^docs/planos/'; then
  echo "[pre-commit] Mudanca em docs/planos/ detectada - rodando 'atualizar_index_planos.py'..."

  if ! python scripts/atualizar_index_planos.py; then
    echo "[pre-commit] ERRO: atualizar_index_planos.py falhou. Commit abortado - corrija e tente de novo."
    exit 1
  fi

  git add -A -- docs/planos MEMORY.md
  echo "[pre-commit] docs/planos/ (subpastas + INDEX.md) e MEMORY.md incluidos no commit."
fi

# --- 3. Regenera telemetria de testes se tools/ foi modificado ---
# Garante que o bloco "testes" de PLANO-EXECUCAO-ESTRUTURADO.json reflita
# pytest real, nunca JSON estático. (Item 2 do plano de correção pós-auditoria)
if echo "$STAGED" | grep -q '^tools/'; then
  echo "[pre-commit] Mudanca em tools/ detectada - regenerando telemetria de testes..."

  if python ecossistema.py status --testes --write; then
    git add -- PLANO-EXECUCAO-ESTRUTURADO.json
    echo "[pre-commit] Telemetria de testes regenerada e incluida no commit."
  else
    echo "[pre-commit] AVISO: regeneracao de telemetria falhou (nao bloqueia commit)."
  fi
fi

# --- 4. code-review-graph: mantem o grafo incremental atualizado ---
# Instalado por 'code-review-graph install'. Remova este bloco para
# desabilitar as checagens de grafo no pre-commit.
if command -v code-review-graph >/dev/null 2>&1; then
    # PYTHONUTF8=1 evita UnicodeEncodeError no Windows: sem isso, o Python
    # usa a codepage antiga do console (cp1252) pra imprimir os paineis do
    # code-review-graph, que tem caracteres que ela nao suporta.
    PYTHONUTF8=1 code-review-graph update || true
    PYTHONUTF8=1 code-review-graph detect-changes --brief || true
fi

# --- 5. Monitoramento (SOMENTE LEITURA) de armazenamento dos harnesses ---
# 'check-silent' so MEDE e AVISA: nunca apaga, move ou arquiva nada.
# Nao troque por 'clean' aqui. A faxina de verdade apaga sessoes antigas e pode
# arquivar bancos inteiros; rodando a cada commit, ela ja levou historico de
# harness junto e quebrou o religamento de sessao do ORCA ('--resume <id>'
# apontando pra sessao que a faxina apagou). Faxina e manual, com o harness
# fechado: python scripts/harness_hygiene.py clean
if [ -f "scripts/harness_hygiene.py" ]; then
    python scripts/harness_hygiene.py check-silent || true
fi

exit 0