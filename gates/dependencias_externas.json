{
  "versao": "1.0.0",
  "descricao": "Manifesto único de dependências externas de terceiros usadas pelo AGENTE (skills e MCPs consumidos por quem desenvolve neste monorepo — nunca componentes de produtos gerados pelas ferramentas aidd-*, esses seguem componentes/<escopo>/mcps/ em gates/manifesto_harnesses.json). Consumido por scripts/gestor_dependencias.py (comandos 'python ecossistema.py dependencia bootstrap|add-skill|add-mcp|list|verify').",
  "skills": {
    "impeccable": {
      "pacote": "impeccable",
      "instalar": "npx impeccable install --providers=claude,cursor,gemini,agents,agent,github,opencode --scope=project -y",
      "verificar": ".claude/skills/impeccable/SKILL.md",
      "gitignore": [
        "*/skills/impeccable/",
        "*/agents/impeccable-*.md",
        "*/commands/impeccable.md",
        "*/hooks/impeccable.json"
      ]
    },
    "code-review-graph": {
      "pacote": "code-review-graph",
      "instalar": "pip install code-review-graph && code-review-graph install -y",
      "verificar": ".claude/skills/review-changes/SKILL.md",
      "gitignore": [
        "*/skills/debug-issue/",
        "*/skills/explore-codebase/",
        "*/skills/refactor-safely/",
        "*/skills/review-changes/",
        ".codebuddy/",
        ".cursor/mcp.json",
        ".cursor/hooks.json",
        ".cursorrules",
        ".windsurfrules",
        "CLAUDE.md",
        "GEMINI.md",
        "CODEBUDDY.md",
        "QODER.md",
        ".kiro/",
        ".qoder/",
        ".vscode/mcp.json",
        "opencode.jsonc",
        ".gemini/settings.json",
        ".gemini/hooks/",
        ".github/code-review-graph.instruction.md"
      ]
    },
    "sandeco-token-reduce": {
      "pacote": "llmlingua",
      "instalar": "python componentes/compartilhado/skills/sandeco-token-reduce/scripts/setup.py",
      "verificar": "componentes/compartilhado/skills/sandeco-token-reduce/.venv",
      "gitignore": [
        "*/skills/sandeco-token-reduce/.venv/"
      ]
    }
  },
  "mcps": {
    "playwright": {
      "pacote": "@playwright/mcp",
      "comando": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": [],
      "harnesses_alvo": [
        "claude-code"
      ]
    },
    "context7": {
      "pacote": "@upstash/context7-mcp",
      "comando": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": [],
      "harnesses_alvo": [
        "claude-code"
      ]
    },
    "github": {
      "pacote": "ghcr.io/github/github-mcp-server",
      "comando": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ],
      "harnesses_alvo": [
        "claude-code"
      ]
    }
  }
}
