      "tipo": "remote",
      "url": "https://docs.mcp.cloudflare.com/mcp",
      "harnesses_alvo": [
        "claude-code",
        "opencode",
        "cursor",
        "gemini-cli",
        "mimocode",
        "antigravity"
      ]
    },
    "code-review-graph": {
      "pacote": "code-review-graph",
      "comando": "code-review-graph",
      "args": [
        "serve"
      ],
      "env": [],
      "harnesses_alvo": [
        "claude-code",
        "opencode",
        "cursor",
        "gemini-cli",
        "mimocode",
        "antigravity",
        "vscode"
      ]
    }
  }
}
