{
  "versao": "1.0.0",
  "descricao": "Manifesto único de dependências externas de terceiros usadas pelo AGENTE (skills e MCPs consumidos por quem desenvolve neste monorepo — nunca componentes de produtos gerados pelas ferramentas aidd-*, esses seguem componentes/<escopo>/mcps/ em gates/manifesto_harnesses.json). Consumido por scripts/gestor_dependencias.py (comandos 'python ecossistema.py dependencia bootstrap|add-skill|add-mcp|list|verify'). Skills com 'verificar' apontando para um ARQUIVO único podem declarar 'sha256' com o hash esperado do artefato instalado — 'dependencia verify'/'bootstrap' bloqueiam ao detectar divergência. MCPs (npx/docker/remoto) não têm artefato local sob controle deste repositório para hashear: o pacote é buscado em tempo de execução pelo próprio harness fora do boundary de instalação deste manifesto, então nenhum campo 'sha256' é declarado para eles (evita checagem fabricada).",
  "skills": {
    "impeccable": {
      "pacote": "impeccable",
      "instalar": "npx impeccable install --providers=claude,cursor,gemini,agents,agent,github,opencode --scope=project -y",
      "verificar": ".claude/skills/impeccable/SKILL.md",
      "sha256": "3895765e9434400dfc1b30e364be002cf499c1718fb2431e65b907c14ae2cb27",
      "gitignore": [
        "*/skills/impeccable/",
        "*/agents/impeccable-*.md",
        "*/commands/impeccable.md",
        "*/hooks/impeccable.json"
      ]
    },
    "code-review-graph": {
      "pacote": "code-review-graph",
      "instalar": "pip install code-review-graph && code-review-graph install -y",
      "verificar": ".claude/skills/review-changes/SKILL.md",
      "sha256": "ead883c2ff2ff76e239f208afaca2a7a7fa79db1a012ce7411d28772019e964b",
      "gitignore": [
        "*/skills/debug-issue/",
        "*/skills/explore-codebase/",
        "*/skills/refactor-safely/",
        "*/skills/review-changes/",
        ".codebuddy/",
        ".cursor/mcp.json",
        ".cursor/hooks.json",
        ".cursorrules",
        ".windsurfrules",
        "CLAUDE.md",
        "GEMINI.md",
        "CODEBUDDY.md",
        "QODER.md",
        ".kiro/",
        ".qoder/",
        ".vscode/mcp.json",
        "opencode.jsonc",
        ".gemini/settings.json",
        ".gemini/hooks/",
        ".github/code-review-graph.instruction.md"
      ]
    },
    "sandeco-token-reduce": {
      "pacote": "llmlingua",
      "instalar": "python componentes/compartilhado/skills/sandeco-token-reduce/scripts/setup.py",
      "verificar": "componentes/compartilhado/skills/sandeco-token-reduce/.venv",
      "sha256": null,
      "sha256_nota": "N/A: 'verificar' aponta para um diretorio (.venv), nao um arquivo unico. Um .venv contem caminhos absolutos do host e binarios especificos de plataforma, entao um hash fixo de diretorio diverge em toda maquina mesmo sem adulteracao — nao seria uma verificacao real. Para travar de verdade os pacotes pip instalados aqui (llmlingua, anthropic), o caminho correto e o mesmo padrao de lockfile com --generate-hashes usado em requirements.lock (ver 04-pin-exato-hashes.md), aplicado a esta skill em um item futuro.",
      "gitignore": [
        "*/skills/sandeco-token-reduce/.venv/"
      ]
    }
  },
  "mcps": {
    "playwright": {
      "pacote": "@playwright/mcp",
      "comando": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ],
      "env": [],
      "harnesses_alvo": [
        "claude-code",
        "opencode",
        "cursor",
        "gemini-cli",
        "mimocode",
        "antigravity"
      ]
    },
    "context7": {
      "pacote": "@upstash/context7-mcp",
      "comando": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": [],
      "harnesses_alvo": [
        "claude-code",
        "opencode",
        "cursor",
        "gemini-cli",
        "mimocode",
        "antigravity"
      ]
    },
    "github": {
      "pacote": "ghcr.io/github/github-mcp-server",
      "comando": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-e",
        "GITHUB_PERSONAL_ACCESS_TOKEN",
        "ghcr.io/github/github-mcp-server"
      ],
      "env": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ],
      "harnesses_alvo": [
        "claude-code",
        "opencode",
        "cursor",
        "gemini-cli",
        "mimocode",
        "antigravity"
      ]
    },
    "cloudflare": {
      "pacote": "Cloudflare MCP oficial (remoto)",
      "tipo": "remote",
      "url": "https://mcp.cloudflare.com/mcp",
      "harnesses_alvo": [
        "claude-code",
        "opencode",
        "cursor",
        "gemini-cli",
        "mimocode",
        "antigravity"
      ]
    },
    "cloudflare-docs": {
