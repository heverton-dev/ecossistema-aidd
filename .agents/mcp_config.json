      "args": [],
      "cwd": "C:\\Users\\trcnologia\\Desktop\\ecossistema-aidd"
    },
    "mcp-gatekeeper": {
      "command": "python",
      "args": [
        "componentes/compartilhado/src-core/mcp_gatekeeper.py"
      ],
      "cwd": "C:\\Users\\trcnologia\\Desktop\\ecossistema-aidd"
    },
    "mobbin-mcp": {
      "command": "python",
      "args": [
        "componentes/compartilhado/mcps/mobbin_mcp/server.py"
      ]
    }
  }
}
