# =============================================================================
# ECOSSISTEMA AIDD — GUIA CANÔNICO DE VARIÁVEIS DE AMBIENTE (.env)
# =============================================================================
# Este é o ÚNICO arquivo de configuração de variáveis para TODO o ecossistema.
# Todas as ferramentas (bridge, ops, forge, master, generator, enterprise)
# e seus MCPs consomem as variáveis centralizadas aqui.
#
# INSTRUÇÕES:
# 1. Copie este arquivo para .env (este nome exato, na raiz do projeto).
# 2. O arquivo .env já está no .gitignore e NUNCA será commitado.
# 3. Siga o passo a passo comentado abaixo de cada variável para obter suas chaves.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. AUTENTICAÇÃO GITHUB
# -----------------------------------------------------------------------------
# COMO OBTER:
# 1. Acesse: https://github.com/settings/tokens
# 2. Clique em "Generate new token" -> "Generate new token (classic)".
# 3. No campo "Note", digite: AIDD Ecosystem.
# 4. Selecione os escopos mínimos:
#    [x] repo (Full control of private repositories)
#    [x] workflow (Update GitHub Action workflows)
#    [x] read:org (Read org and team membership)
# 5. Clique em "Generate token" no final da página e copie o código (começa com ghp_).
GITHUB_PERSONAL_ACCESS_TOKEN=

# COMO OBTER:
# Seu nome de usuário exato no GitHub (o que aparece na sua URL: github.com/SEU_USUARIO).
GITHUB_USER=

# -----------------------------------------------------------------------------
# 2. CLOUDFLARE & AUTOMAÇÃO DE DNS
# -----------------------------------------------------------------------------
# COMO OBTER O API TOKEN:
# 1. Acesse: https://dash.cloudflare.com/profile/api-tokens
# 2. Clique no botão azul "Create Token".
# 3. Localize o template "Edit zone DNS" e clique em "Use template".
# 4. Em "Zone Resources":
#    - Selecione: "Include" -> "Specific zone" -> escolha o seu domínio (ex: vpsconexao.org)
#      (ou escolha "All zones" se quiser que funcione em qualquer domínio da sua conta).
# 5. No final da página, clique em "Continue to summary" e depois em "Create Token".
# 6. Copie o token gerado (atenção: ele só é exibido uma única vez).
CLOUDFLARE_API_TOKEN=

# COMO OBTER O ZONE ID:
# 1. Acesse o painel principal da Cloudflare: https://dash.cloudflare.com/
# 2. Clique no seu domínio (ex: vpsconexao.org).
# 3. Na página inicial do domínio (aba "Overview"), role a barra lateral direita até o final.
# 4. No bloco "API", copie o código em "Zone ID" (um hash de 32 caracteres hexadecimais).
CLOUDFLARE_ZONE_ID=

# COMO DEFINIR:
# O domínio raiz que você gerencia na Cloudflare onde os subdomínios serão criados.
# Exemplo: se você quer criar "app.meusite.com", coloque aqui: meusite.com
DEFAULT_ROOT_DOMAIN=vpsconexao.org

# -----------------------------------------------------------------------------
# 3. SUA VPS (SERVIDOR ONDE O SOFTWARE VAI RODAR)
# -----------------------------------------------------------------------------
# COMO OBTER:
# O endereço IPv4 público da sua máquina VPS (fornecido pelo seu provedor: Hetzner,
# DigitalOcean, Contabo, Linode, AWS, etc.). Exemplo: 144.76.54.12
VPS_HOST=

# Porta padrão de acesso SSH (geralmente 22, a menos que seu provedor tenha alterado).
VPS_PORT=22

# Usuário administrador da VPS (na grande maioria dos servidores é "root" ou "ubuntu").
VPS_USER=root

# AUTENTICAÇÃO NA VPS (Preencha APENAS UMA das duas opções abaixo):
# Opção A: A senha do usuário root/administrador da sua VPS.
VPS_PASSWORD=

# Opção B: Se você usa chave SSH em vez de senha, informe o caminho completo do arquivo da chave.
# Exemplo Windows: C:/Users/seu_usuario/.ssh/id_rsa
# Exemplo Linux/Mac: ~/.ssh/id_rsa
SSH_KEY_PATH=

# -----------------------------------------------------------------------------
# 4. ORQUESTRAÇÃO DOCKER & TRAEFIK (REVERSE PROXY / SSL)
# -----------------------------------------------------------------------------
# COMO VERIFICAR:
# No Portainer da sua VPS -> Menu esquerdo "Networks":
# Procure a rede que possui Driver = "overlay" (onde o Traefik está escutando).
# Se você instalou o Traefik padrão para Swarm, o nome comum é network_conexao ou traefik-public.
TRAEFIK_NETWORK=network_conexao

# O nome do certificado SSL configurado no seu Traefik para emissão Let's Encrypt.
# O padrão mais utilizado em stacks Swarm é letsencryptresolver ou letsencrypt.
TRAEFIK_CERTRESOLVER=letsencryptresolver

# O entrypoint seguro configurado no Traefik (quase sempre é "websecure" para a porta 443).
TRAEFIK_ENTRYPOINT=websecure

# -----------------------------------------------------------------------------
# 5. BANCO DE DADOS POSTGRESQL & POSTGREST (CONTAINERS INTERNOS)
# -----------------------------------------------------------------------------
# Estas credenciais são para o banco de dados PostgreSQL interno que o AIDD Bridge
# cria dentro da sua VPS para substituir o Supabase Cloud.
# Você pode manter os padrões sugeridos abaixo ou alterar a senha conforme desejar.
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=aidd_secure_vps_pwd_2026

# Chave secreta interna JWT para assinatura de requisições do PostgREST (mínimo 32 caracteres).
PGRST_JWT_SECRET=super-secret-jwt-token-with-at-least-32-chars-long

# -----------------------------------------------------------------------------
# 6. PLATAFORMAS COMPLEMENTARES (OPCIONAL — Usado pelo aidd-ops)
# -----------------------------------------------------------------------------
# Se você utiliza o Coolify como orquestrador na VPS, preencha abaixo:
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=

# -----------------------------------------------------------------------------
# 7. BANCO DE DADOS, MENSAGERIA & EVENTOS
# -----------------------------------------------------------------------------
# URL de conexão com banco de dados principal (SQLite ou PostgreSQL)
DATABASE_URL=sqlite:///storage/sqlite/app.db
# URL do Message Broker / EventBus (Redis)
EVENTBUS_URL=redis://localhost:6379/0
# Chave Service Role para adapters de banco compatíveis (Supabase/PostgREST)
SUPABASE_SERVICE_ROLE_KEY=
# Configurações do worker de eventos transacionais outbox
OUTBOX_BLPOP_QUEUE=events_outbox
OUTBOX_BLPOP_TIMEOUT=2

# -----------------------------------------------------------------------------
# 8. SERVIDOR HTTP, REDE & SEGURANÇA
# -----------------------------------------------------------------------------
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
ALLOW_ANONYMOUS=true
APP_ENV=development
ENV=development
ENVIRONMENT=development
LOG_LEVEL=INFO
JWT_SECRET_KEY=super-secret-jwt-signing-key-for-local-development-32chars
# Alias de domínio Cloudflare utilizado pelo aidd-bridge
CF_ROOT_DOMAIN=vpsconexao.org

# -----------------------------------------------------------------------------
# 9. AUTENTICAÇÃO FEDERADA & OIDC (FastAPI Server)
# -----------------------------------------------------------------------------
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_ISSUER=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_REDIRECT_URI=

# -----------------------------------------------------------------------------
# 10. OBSERVABILIDADE & OPENTELEMETRY
# -----------------------------------------------------------------------------
OTEL_SERVICE_NAME=aidd-app
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_TRACES_EXPORTER=none

# -----------------------------------------------------------------------------
# 11. LLM, PROVEDORES & PIPELINE GENERATOR
# -----------------------------------------------------------------------------
LLM_MODEL=groq/llama-3.3-70b-versatile
AIDD_LLM_MODEL=
AIDD_HARNESS_NAME=
SUBAGENTE_TIMEOUT=300
LLM_TIMEOUT_SEGUNDOS=120
LLM_MAX_TENTATIVAS=3
AIDD_TIMEOUT_DELEGACAO=300
AIDD_MODO=interativo

# Chaves de API para provedores de modelos de linguagem (preencha conforme provedor)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_API_BASE=

# -----------------------------------------------------------------------------
# 12. ORQUESTRAÇÃO DE WORKFLOWS PREFECT
# -----------------------------------------------------------------------------
PREFECT_HOME=.prefect
AIDD_PREFECT_HOME=.prefect
PREFECT_API_BLOCK_ON_INIT_SEPARATELY=true
PREFECT_SERVER_ENABLE_UI=false
PREFECT_TELEMETRY_ENABLED=false

# -----------------------------------------------------------------------------
# 13. INFRAESTRUTURA & OPS
# -----------------------------------------------------------------------------
HELM_BIN=helm

# -----------------------------------------------------------------------------
# 14. GOVERNANÇA, SUBAGENTES & LIVRO-TEXTO DO ECOSSISTEMA AIDD
# -----------------------------------------------------------------------------
AIDD_ENV=development
AIDD_SUBAGENT_CONFIRMED=
AIDD_SUBAGENT_LOCK_FILE=
AIDD_TESTES_REAIS_FERRAMENTAS=
AIDD_LIVRO_PASTA=
AIDD_LIVRO_PROJETO=
WORKSPACE_ROOT=
ORCA_WORKSPACE=
ORCA_DEFAULT_HARNESS=gemini

# -----------------------------------------------------------------------------
# 15. HARNESSES DE IA (Injetadas pelo runtime hospedeiro; documentadas para emulação)
# -----------------------------------------------------------------------------
ANTIGRAVITY_AGENT=
ANTIGRAVITY_CLI=
AGY_SESSION=
CLAUDECODE=
CLAUDE_CODE_EXECPATH=
GEMINI_CLI=
GEMINI_SYSTEM_INSTRUCTIONS_PATH=
GEMINI_SESSION=
OPENCODE=
OPENCODE_SESSION=
OPENCODE_CONFIG_DIR=
MIMOCODE=
MIMO_SESSION=
MIMO_WORKSPACE=