# =============================================================================
# ECOSSISTEMA AIDD — VARIÁVEIS DE AMBIENTE (fonte única, nunca commitar valores reais)
# =============================================================================
# Copie este arquivo para `.env` (já no .gitignore) e preencha os valores reais.
# `.env` é carregado automaticamente por `python ecossistema.py <qualquer comando>`
# (via python-dotenv, sem sobrescrever variável já exportada no shell) e por
# `componentes/aidd-ops/mcps/cloudflare-mcp/server.py` quando iniciado direto.
#
# LIMITAÇÃO IMPORTANTE: MCPs de terceiros registrados em `.mcp.json` /
# `opencode.jsonc` / `.cursor/mcp.json` / `.gemini/settings.json` /
# `mimocode.jsonc` / `.agents/mcp_config.json` (ver gates/dependencias_externas.json)
# são lançados PELO PRÓPRIO HARNESS (Claude Code, Cursor, etc.), não por este
# arquivo — a expansão "${VAR}" nesses arquivos só funciona se a variável já
# estiver exportada no shell/ambiente ANTES de abrir o harness. Este `.env` não
# alimenta esses processos automaticamente; exporte manualmente antes de abrir
# o harness (veja exemplos de export ao final deste arquivo).

# --- github (MCP de terceiro registrado em gates/dependencias_externas.json) ---
# Personal Access Token do GitHub (escopo mínimo necessário para as tools do
# github-mcp-server que o agente usa: repo, read:org conforme a necessidade).
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Cloudflare (usado por componentes/aidd-ops/mcps/cloudflare-mcp/server.py
#     e por tools/aidd-ops/scripts/pipeline_ops_deploy.py) ---
# Token de API da Cloudflare com permissão de edição de DNS na(s) zona(s) alvo.
CLOUDFLARE_API_TOKEN=

# --- Coolify (usado por tools/aidd-ops/scripts/pipeline_ops.py, pipeline de deploy) ---
COOLIFY_BASE_URL=
COOLIFY_API_TOKEN=

# --- SSH (usado por tools/aidd-ops/src/core/ssh_runner.py) ---
# Caminho local da chave privada SSH usada para operações remotas do aidd-ops.
SSH_KEY_PATH=

# =============================================================================
# Nota: os MCPs remotos oficiais da Cloudflare (cloudflare, cloudflare-docs)
# usam autenticação OAuth no próprio harness ao conectar — não precisam de
# variável de ambiente aqui. playwright e context7 também não usam credenciais.
# =============================================================================
