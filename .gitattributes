# Set default behavior to automatically normalize line endings to LF
* text=auto eol=lf

# Explicitly declare text files you want to always be normalized and converted to LF on checkout
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.sh text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf

# Denote all binary files that should not be modified by Git
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.sqlite3 binary
*.wasm binary

# ISSUE-USA-0006 — fora do pacote de distribuição (git archive / release)
tests/ export-ignore
testes/ export-ignore
*.db export-ignore
requirements-dev.txt export-ignore
requirements-dev.lock export-ignore
pytest.ini export-ignore
__pycache__/ export-ignore
.pytest_cache/ export-ignore
.worktrees/ export-ignore
.ade_tmp/ export-ignore
PLANO-EXECUCAO-ESTRUTURADO.json export-ignore
.pre-commit-config.yaml export-ignore
.secrets.baseline export-ignore
docs/relatorios/ export-ignore
docs/reports/ export-ignore
docs/livros/ export-ignore
